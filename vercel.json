{
  "crons": [
    {
      "path": "/api/job-alerts/send",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/monetization/maintenance",
      "schedule": "0 2 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/auth/signin",
      "destination": "/auth/login",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
        }
      ]
    }
  ]
}
